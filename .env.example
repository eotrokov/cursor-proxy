# Скопируйте в .env и задайте свои значения:
#   cp .env.example .env

# Логин и пароль для HTTP/SOCKS прокси (обязательно смените)
PROXY_USER=cursor
PROXY_PASSWORD=change-me-to-a-long-random-string

# Порты на хосте VPS
HTTP_PORT=3128
SOCKS_PORT=1080

# Публичный IP или домен VPS (для подсказок в клиентском конфиге)
# PROXY_HOST=203.0.113.10
